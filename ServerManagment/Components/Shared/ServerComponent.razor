
@if (server != null)
{
    <div data-name="@server.Name" data-status="Server is  @(server.IsOnline ? "Online" : "Offline")"
         style="@($"color:{(server.IsOnline ? "green" : "red")}")">
        @server.Name is in @server.City is @(server.IsOnline ? "Online" : "Offline")
        <button type="button" class="btn btn-primary" @onclick="ChangeStatus">Turn On/Off</button>
    </div>
}