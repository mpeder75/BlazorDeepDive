<div class="col">
    <div class="card @(selectedCity.Equals(city, StringComparison.OrdinalIgnoreCase) ? "border-success" : "")">
        <img src="@($"/images/{city}.png")" class="card-img-top" alt="..."/>
        <div class="card-body">
            <button type="button" class="btn btn-primary" @onclick="@(() => { SelectCity(city); })">@city</button>
        </div>
    </div>
</div>